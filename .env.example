# ==============================================================================
# 대한민국 법령 RAG 온디바이스 환경 설정
# ==============================================================================

# [온디바이스 LLM 설정]
# 온디바이스 LLM 사용 여부 (true: 로컬 LLM 가속 엔진 사용, false: 비활성화)
# 미설정 또는 비워둘 시 기본값은 false(비활성화)이며, 조문 요약 모드로 안전하게 작동합니다.
USE_ONDEVICE_LLM=true
ONDEVICE_LLM="./data/models/EXAONE-4.0-1.2B-Q4_K_M.gguf"

# [Qdrant 벡터 데이터베이스 설정]
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=korean_laws

# [법제처 오픈소스 법령 원본 데이터셋 Git 저장소 URL]
LEGALIZE_KR_REPO_URL=https://github.com/legalize-kr/legalize-kr.git

# [RAG 로컬 백엔드 서버 포트]
PORT=3100

# [RAG 검색 설정]
# 질의 시 참조할 최대 근거 법조문 수 (기본값: 4)
MAX_REFERENCES=4

# [법령 원본 마크다운 데이터셋 경로 (기본값: ./data/raws)]
RAW_LAWS_DIR=./data/raws

# [시스템 프롬프트 마크다운 파일 경로 (기본값: ./data/prompts/system_prompt.md)]
# SYSTEM_PROMPT_PATH=./data/prompts/system_prompt.md

