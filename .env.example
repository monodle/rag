# ==============================================================================
# 대한민국 법령 RAG 온디바이스 환경 설정
# ==============================================================================

APP_VERSION=1.1

# [GitHub Releases 태그 설정]
RELEASE_TAG_INSTALLER=latest
RELEASE_TAG_ENGINE=v1.0.0
RELEASE_TAG_DB=data-v1

# [RAG 로컬 백엔드 서버 포트]
DEV_PORT=34200
PROD_PORT=34100

# [RAG 검색 설정]
# 질의 시 참조할 최대 근거 법조문 수 (UI 5개씩 점진적 더보기 지원, 기본값: 20)
MAX_REFERENCES=100
# 근거 법조문 최소 코사인 유사도 노출 임계치 (74% 이상만 노출, 기본값: 0.74)
MIN_REFERENCE_SCORE_THRESHOLD=0.75

# [법제처 오픈소스 법령 원본 데이터셋 Git 저장소 URL]
LEGALIZE_KR_REPO_URL=https://github.com/legalize-kr/legalize-kr.git
